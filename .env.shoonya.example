# Keep SmartAPI configured: it remains the dashboard's market-data feed.
EXECUTION_BROKER=SHOONYA

# Shoonya credentials — copy these keys into .env and fill locally.
SHOONYA_USER_ID=
SHOONYA_PASSWORD=
SHOONYA_TOTP_SECRET=
SHOONYA_VENDOR_CODE=
SHOONYA_API_SECRET=
SHOONYA_IMEI=mTerminals

# Shoonya product code for F&O: M = NRML, I = MIS.
SHOONYA_PRODUCT_TYPE=M

# Optional if the official SDK is not in runtime/shoonya_api:
# SHOONYA_SDK_PATH=/absolute/path/to/ShoonyaApi-py
