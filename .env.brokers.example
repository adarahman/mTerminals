# Select each role independently. Do not place real credentials in this file.
# Execution: SMARTAPI | UPSTOX | KITE | SHOONYA | BREEZE
EXECUTION_BROKER=SMARTAPI
# Snapshot data: SMARTAPI | UPSTOX | KITE | SHOONYA | BREEZE | KOTAK | NSE_BSE
MARKET_DATA_PROVIDER=SMARTAPI
# Optional failover for snapshot calls. Leave blank to disable.
MARKET_DATA_FALLBACK_PROVIDER=
# WebSocket ticks: SMARTAPI | UPSTOX | SHOONYA. Keep it aligned with the
# execution broker unless you deliberately use a separate tick feed.
LIVE_FEED_PROVIDER=SMARTAPI

# Angel One SmartAPI
SMARTAPI_KEY=
SMARTAPI_CLIENT_CODE=
SMARTAPI_PIN=
SMARTAPI_TOTP_SECRET=

# Upstox (daily access token)
UPSTOX_ACCESS_TOKEN=

# Zerodha Kite (daily access token)
KITE_API_KEY=
KITE_ACCESS_TOKEN=

# ICICI Direct Breeze (daily API session)
BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_API_SESSION=
BREEZE_PRODUCT_TYPE=options

# Shoonya / Finvasia
SHOONYA_USER_ID=
SHOONYA_PASSWORD=
SHOONYA_TOTP_SECRET=
SHOONYA_VENDOR_CODE=
SHOONYA_API_SECRET=
SHOONYA_IMEI=mTerminals
